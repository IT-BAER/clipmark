<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipmark.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Corner lock on a premium tool while it is locked (trial ended, no license). -->
        <Style x:Key="LockBadge" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE72E;" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-7,-6" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4,8,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="NewButton" Click="OnNew" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="New capture" AutomationProperties.Name="New capture">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xF406;" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" Click="OnNewRecording"
                        ToolTipService.ToolTip="New recording" AutomationProperties.Name="New recording">
                    <FontIcon FontSize="16" Glyph="&#xE714;" />
                </Button>
                <Button x:Name="OpenButton" Click="OnOpen" ToolTipService.ToolTip="Open an image or editable PNG (Ctrl+O)" AutomationProperties.Name="Open">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                </Button>
                <Button x:Name="HistoryButton" Click="OnHistoryClick" ToolTipService.ToolTip="Capture history" AutomationProperties.Name="Capture history">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>
                <DropDownButton x:Name="ModeButton" ToolTipService.ToolTip="Capture mode" AutomationProperties.Name="Capture mode">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ModeMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="DelayButton" ToolTipService.ToolTip="Delay" AutomationProperties.Name="Delay">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DelayMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <StackPanel x:Name="EditTools" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <ToggleButton x:Name="SelectButton" Tag="Select" Click="OnToolClick"
                              ToolTipService.ToolTip="Select (V)" AutomationProperties.Name="Select">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                        <FontIcon x:Name="SelectLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="PenButton" Tag="Pen" Click="OnToolClick"
                              ToolTipService.ToolTip="Pen (P)" AutomationProperties.Name="Pen">
                    <FontIcon FontSize="16" Glyph="&#xEE56;" />
                </ToggleButton>
                <ToggleButton x:Name="HighlighterButton" Tag="Highlighter" Click="OnToolClick"
                              ToolTipService.ToolTip="Highlighter (H)" AutomationProperties.Name="Highlighter">
                    <FontIcon FontSize="16" Glyph="&#xE7E6;" />
                </ToggleButton>
                <ToggleButton x:Name="EraserButton" Tag="Eraser" Click="OnToolClick"
                              ToolTipService.ToolTip="Eraser (E)" AutomationProperties.Name="Eraser">
                    <FontIcon FontSize="16" Glyph="&#xE75C;" />
                </ToggleButton>
                <ToggleButton x:Name="TextButton" Tag="Text" Click="OnToolClick"
                              ToolTipService.ToolTip="Text (T)" AutomationProperties.Name="Text">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE8D2;" />
                        <FontIcon x:Name="TextLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleSplitButton x:Name="ShapeButton" IsCheckedChanged="OnShapeCheckedChanged"
                                   ToolTipService.ToolTip="Shapes" AutomationProperties.Name="Shapes">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout x:Name="ShapeMenu" Placement="Bottom" />
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleButton x:Name="EyedropperButton" Tag="Eyedropper" Click="OnToolClick"
                              ToolTipService.ToolTip="Eyedropper (I): copies the color as #RRGGBB" AutomationProperties.Name="Eyedropper">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xEF3C;" />
                        <FontIcon x:Name="EyedropperLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="BucketButton" Tag="Bucket" Click="OnToolClick"
                              ToolTipService.ToolTip="Fill (G): a rectangle or oval, else the canvas background" AutomationProperties.Name="Fill">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE771;" />
                        <FontIcon x:Name="BucketLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <DropDownButton x:Name="StyleButton" ToolTipService.ToolTip="Color and width" AutomationProperties.Name="Color and width">
                    <DropDownButton.Flyout>
                        <Flyout x:Name="StyleFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="CropButton" Click="OnCropClick"
                              ToolTipService.ToolTip="Crop" AutomationProperties.Name="Crop">
                    <FontIcon FontSize="16" Glyph="&#xE7A8;" />
                </ToggleButton>
                <Button x:Name="ApplyCropButton" Click="OnApplyCrop" Visibility="Collapsed"
                        ToolTipService.ToolTip="Apply crop (Enter)" AutomationProperties.Name="Apply crop">
                    <FontIcon FontSize="16" Glyph="&#xE8FB;" />
                </Button>
                <Button x:Name="CancelCropButton" Click="OnCancelCrop" Visibility="Collapsed"
                        ToolTipService.ToolTip="Cancel crop (Esc)" AutomationProperties.Name="Cancel crop">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>
                <StackPanel x:Name="CropFields" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropX" Tag="X" PlaceholderText="X" Width="76" AcceptsExpression="True" ValueChanged="OnCropField"
                               ToolTipService.ToolTip="Left edge (px); arithmetic such as 100+20 works" AutomationProperties.Name="Crop X" />
                    <TextBlock Text="Y" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropY" Tag="Y" PlaceholderText="Y" Width="76" AcceptsExpression="True" ValueChanged="OnCropField"
                               ToolTipService.ToolTip="Top edge (px)" AutomationProperties.Name="Crop Y" />
                    <TextBlock Text="W" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropW" Tag="W" PlaceholderText="W" Width="76" AcceptsExpression="True" ValueChanged="OnCropField"
                               ToolTipService.ToolTip="Width (px); arithmetic such as 800+20 works" AutomationProperties.Name="Crop width" />
                    <TextBlock Text="H" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropH" Tag="H" PlaceholderText="H" Width="76" AcceptsExpression="True" ValueChanged="OnCropField"
                               ToolTipService.ToolTip="Height (px)" AutomationProperties.Name="Crop height" />
                </StackPanel>
                <ToggleButton x:Name="TextActionsButton" Click="OnTextActions"
                              ToolTipService.ToolTip="Text actions: copy text, redact emails and phone numbers, read QR codes" AutomationProperties.Name="Text actions">
                    <FontIcon FontSize="16" Glyph="&#xE8C1;" />
                </ToggleButton>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="UndoButton" Click="OnUndo" IsEnabled="False"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button x:Name="RedoButton" Click="OnRedo" IsEnabled="False"
                        ToolTipService.ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                <StackPanel x:Name="OutputTools" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <SplitButton Click="OnSave" ToolTipService.ToolTip="Save as (Ctrl+S)" AutomationProperties.Name="Save as">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="SaveEditableItem" Text="Save as editable PNG (Ctrl+Shift+S)" Click="OnSaveEditable"
                                                ToolTipService.ToolTip="Keeps the objects editable. The file also holds the uncropped image and anything drawn over it.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button Click="OnCopy" ToolTipService.ToolTip="Copy (Ctrl+C)" AutomationProperties.Name="Copy">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                    <Button Click="OnShare" ToolTipService.ToolTip="Share" AutomationProperties.Name="Share">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                    </Button>
                    <SplitButton x:Name="AgentButton" Click="OnSendToAgent" ToolTipService.ToolTip="Send to AI"
                                 AutomationProperties.Name="Send to AI">
                        <FontIcon FontSize="16" Glyph="&#xE724;" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="AgentMenu" Placement="Bottom" Opening="OnAgentMenuOpening" />
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>
                <Button Click="OnSettings" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel x:Name="TextActionsBar" Orientation="Horizontal" Spacing="8" Margin="8,0,8,8"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TextActionsStatus" VerticalAlignment="Center" AutomationProperties.Name="Text actions status"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="CopyAllTextButton" Content="Copy all text" Click="OnCopyAllText" IsEnabled="False"
                        AutomationProperties.Name="Copy all text" />
                <Button x:Name="QuickRedactButton" Content="Quick redact" Click="OnQuickRedact" IsEnabled="False"
                        ToolTipService.ToolTip="Blacks out email addresses and phone numbers in the image" AutomationProperties.Name="Quick redact" />
                <StackPanel x:Name="QrResults" Orientation="Horizontal" Spacing="8" />
            </StackPanel>
            <InfoBar x:Name="Message" Margin="8,0,8,8" IsOpen="False" Severity="Error" />
        </StackPanel>

        <TextBlock x:Name="Hint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer x:Name="ImageScroller" Grid.Row="2" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8" />

        <MediaPlayerElement x:Name="VideoPlayer" Grid.Row="2" Visibility="Collapsed" Margin="8,0,8,8"
                            AreTransportControlsEnabled="True" AutomationProperties.Name="Recording" />
    </Grid>
</Page>
