<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipmark.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Corner lock on a premium tool while it is locked (trial ended, no license). -->
        <Style x:Key="LockBadge" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE72E;" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-7,-6" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4,8,8" ColumnSpacing="8">
            <Grid.Resources>
                <!-- WinUI pads buttons 1 DIP more at the bottom for the text baseline; icon buttons need it even (same height).
                     Split buttons set Padding 11,6.5,11,6.5 and drop-down buttons 11,5.5,11,5.5 themselves (a based-on style crashes them). -->
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Padding" Value="11,5.5,11,5.5" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Padding" Value="11,5.5,11,5.5" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="NewButton" x:Uid="NewButton" Click="OnNew" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xF406;" />
                        <TextBlock x:Uid="NewButtonText" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" x:Uid="RecordButton" Click="OnNewRecording">
                    <FontIcon FontSize="16" Glyph="&#xE714;" />
                </Button>
                <Button x:Name="OpenButton" x:Uid="OpenButton" Click="OnOpen">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                </Button>
                <Button x:Name="HistoryButton" x:Uid="HistoryButton" Click="OnHistoryClick">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>
                <DropDownButton x:Name="ModeButton" x:Uid="ModeButton" Padding="11,5.5,11,5.5">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ModeMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="DelayButton" x:Uid="DelayButton" Padding="11,5.5,11,5.5">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DelayMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <StackPanel x:Name="EditTools" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <ToggleButton x:Name="SelectButton" x:Uid="SelectButton" Tag="Select" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                        <FontIcon x:Name="SelectLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="PenButton" x:Uid="PenButton" Tag="Pen" Click="OnToolClick">
                    <FontIcon FontSize="16" Glyph="&#xEE56;" />
                </ToggleButton>
                <ToggleButton x:Name="HighlighterButton" x:Uid="HighlighterButton" Tag="Highlighter" Click="OnToolClick">
                    <FontIcon FontSize="16" Glyph="&#xE7E6;" />
                </ToggleButton>
                <ToggleButton x:Name="EraserButton" x:Uid="EraserButton" Tag="Eraser" Click="OnToolClick">
                    <FontIcon FontSize="16" Glyph="&#xE75C;" />
                </ToggleButton>
                <ToggleButton x:Name="TextButton" x:Uid="TextButton" Tag="Text" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE8D2;" />
                        <FontIcon x:Name="TextLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleSplitButton x:Name="ShapeButton" x:Uid="ShapeButton" Padding="11,6.5,11,6.5" IsCheckedChanged="OnShapeCheckedChanged">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout x:Name="ShapeMenu" Placement="Bottom" />
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleButton x:Name="EyedropperButton" x:Uid="EyedropperButton" Tag="Eyedropper" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xEF3C;" />
                        <FontIcon x:Name="EyedropperLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="BucketButton" x:Uid="BucketButton" Tag="Bucket" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE771;" />
                        <FontIcon x:Name="BucketLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <DropDownButton x:Name="StyleButton" x:Uid="StyleButton" Padding="11,5.5,11,5.5">
                    <DropDownButton.Flyout>
                        <Flyout x:Name="StyleFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="CropButton" x:Uid="CropButton" Click="OnCropClick">
                    <FontIcon FontSize="16" Glyph="&#xE7A8;" />
                </ToggleButton>
                <Button x:Name="ApplyCropButton" x:Uid="ApplyCropButton" Click="OnApplyCrop" Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE8FB;" />
                </Button>
                <Button x:Name="CancelCropButton" x:Uid="CancelCropButton" Click="OnCancelCrop" Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>
                <StackPanel x:Name="CropFields" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Uid="CropXLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropX" x:Uid="CropX" Tag="X" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                    <TextBlock x:Uid="CropYLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropY" x:Uid="CropY" Tag="Y" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                    <TextBlock x:Uid="CropWLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropW" x:Uid="CropW" Tag="W" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                    <TextBlock x:Uid="CropHLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropH" x:Uid="CropH" Tag="H" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                </StackPanel>
                <ToggleButton x:Name="TextActionsButton" x:Uid="TextActionsButton" Click="OnTextActions">
                    <FontIcon FontSize="16" Glyph="&#xE8C1;" />
                </ToggleButton>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="UndoButton" x:Uid="UndoButton" Click="OnUndo" IsEnabled="False">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button x:Name="RedoButton" x:Uid="RedoButton" Click="OnRedo" IsEnabled="False">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                <StackPanel x:Name="OutputTools" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <SplitButton x:Uid="SaveButton" Click="OnSave" Padding="11,6.5,11,6.5">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="SaveEditableItem" x:Uid="SaveEditableItem" Click="OnSaveEditable">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Uid="CopyButton" Click="OnCopy">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                    <Button x:Uid="ShareButton" Click="OnShare">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                    </Button>
                    <SplitButton x:Name="AgentButton" x:Uid="AgentButton" Padding="11,6.5,11,6.5" Click="OnSendToAgent">
                        <FontIcon FontSize="16" Glyph="&#xE724;" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="AgentMenu" Placement="Bottom" Opening="OnAgentMenuOpening" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Name="AskAiButton" x:Uid="AskAiButton" Click="OnAskAi">
                        <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                    </Button>
                </StackPanel>
                <Button x:Uid="SettingsButton" Click="OnSettings" Background="Transparent" BorderThickness="0">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel x:Name="TextActionsBar" Orientation="Horizontal" Spacing="8" Margin="8,0,8,8"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TextActionsStatus" x:Uid="TextActionsStatus" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="CopySelectedTextButton" x:Uid="CopySelectedTextButton" Click="OnCopySelectedText" IsEnabled="False" />
                <Button x:Name="CopyAllTextButton" x:Uid="CopyAllTextButton" Click="OnCopyAllText" IsEnabled="False" />
                <Button x:Name="QuickRedactButton" x:Uid="QuickRedactButton" Click="OnQuickRedact" IsEnabled="False" />
                <StackPanel x:Name="QrResults" Orientation="Horizontal" Spacing="8" />
            </StackPanel>
            <InfoBar x:Name="Message" Margin="8,0,8,8" IsOpen="False" Severity="Error" />
        </StackPanel>

        <TextBlock x:Name="Hint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer x:Name="ImageScroller" Grid.Row="2" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8" />

        <MediaPlayerElement x:Name="VideoPlayer" x:Uid="VideoPlayer" Grid.Row="2" Visibility="Collapsed" Margin="8,0,8,8"
                            AreTransportControlsEnabled="True" />
    </Grid>
</Page>
