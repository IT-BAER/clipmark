<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipmark.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4,8,8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="NewButton" Click="OnNew" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="New capture" AutomationProperties.Name="New capture">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xF406;" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="ModeButton" ToolTipService.ToolTip="Capture mode" AutomationProperties.Name="Capture mode">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ModeMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="DelayButton" ToolTipService.ToolTip="Delay" AutomationProperties.Name="Delay">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DelayMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Button HorizontalAlignment="Right" Click="OnSettings" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <InfoBar x:Name="Message" Grid.Row="1" Margin="8,0,8,8" IsOpen="False" Severity="Error" />

        <TextBlock x:Name="Hint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer x:Name="ImageScroller" Grid.Row="2" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8">
            <Image x:Name="CaptureImage" Stretch="Uniform" Margin="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Captured image" />
        </ScrollViewer>
    </Grid>
</Page>
