<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipmark.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Clipmark.App"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Corner lock on a premium tool while it is locked (trial ended, no license). -->
        <Style x:Key="LockBadge" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE72E;" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-7,-6" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Narrow windows (MainPage.Toolbar.cs): the edit tools move to row 1 and wrap there; the top row gives up labels and buttons. -->
        <Grid x:Name="Toolbar" Padding="8,4,8,8" ColumnSpacing="8" SizeChanged="OnToolbarSizeChanged">
            <Grid.Resources>
                <!-- WinUI pads buttons 1 DIP more at the bottom for the text baseline; icon buttons need it even (same height).
                     Split buttons set Padding 11,6.5,11,6.5 and drop-down buttons 11,5.5,11,5.5 themselves (a based-on style crashes them). -->
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Padding" Value="11,5.5,11,5.5" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Padding" Value="11,5.5,11,5.5" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="CaptureTools" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                <Button x:Name="NewButton" x:Uid="NewButton" Click="OnNew" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xF406;" />
                        <!-- Line height of the 16 px icons, so the button is as tall as the icon buttons. -->
                        <TextBlock x:Name="NewButtonText" x:Uid="NewButtonText" LineHeight="16" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" x:Uid="RecordButton" Click="OnNewRecording">
                    <FontIcon FontSize="16" Glyph="&#xE714;" />
                </Button>
                <Button x:Name="OpenButton" x:Uid="OpenButton" Click="OnOpen">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                </Button>
                <Button x:Name="HistoryButton" x:Uid="HistoryButton" Click="OnHistoryClick">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>
                <DropDownButton x:Name="ModeButton" x:Uid="ModeButton" Padding="11,5.5,11,5.5">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ModeMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="DelayButton" x:Uid="DelayButton" Padding="11,5.5,11,5.5">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DelayMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <local:WrapPanel x:Name="EditTools" Grid.Column="1" Spacing="4" LineSpacing="4" Visibility="Collapsed">
                <ToggleButton x:Name="SelectButton" x:Uid="SelectButton" Tag="Select" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                        <FontIcon x:Name="SelectLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="PenButton" x:Uid="PenButton" Tag="Pen" Click="OnToolClick">
                    <FontIcon FontSize="16" Glyph="&#xEE56;" />
                </ToggleButton>
                <ToggleButton x:Name="HighlighterButton" x:Uid="HighlighterButton" Tag="Highlighter" Click="OnToolClick">
                    <FontIcon FontSize="16" Glyph="&#xE7E6;" />
                </ToggleButton>
                <ToggleSplitButton x:Name="EraserButton" x:Uid="EraserButton" Padding="11,6.5,11,6.5" IsCheckedChanged="OnEraserCheckedChanged">
                    <FontIcon FontSize="16" Glyph="&#xE75C;" />
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout x:Name="EraserMenu" Placement="Bottom">
                            <MenuFlyoutItem x:Uid="EraseAllItem" Click="OnEraseAll">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleButton x:Name="TextButton" x:Uid="TextButton" Tag="Text" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE8D2;" />
                        <FontIcon x:Name="TextLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleSplitButton x:Name="ShapeButton" x:Uid="ShapeButton" Padding="11,6.5,11,6.5" IsCheckedChanged="OnShapeCheckedChanged">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout x:Name="ShapeMenu" Placement="Bottom" />
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleButton x:Name="EyedropperButton" x:Uid="EyedropperButton" Tag="Eyedropper" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xEF3C;" />
                        <FontIcon x:Name="EyedropperLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="BucketButton" x:Uid="BucketButton" Tag="Bucket" Click="OnToolClick">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE771;" />
                        <FontIcon x:Name="BucketLock" Style="{StaticResource LockBadge}" />
                    </Grid>
                </ToggleButton>
                <DropDownButton x:Name="StyleButton" x:Uid="StyleButton" Padding="11,5.5,11,5.5">
                    <DropDownButton.Flyout>
                        <Flyout x:Name="StyleFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Border x:Name="DrawSeparator" Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="CropButton" x:Uid="CropButton" Click="OnCropClick">
                    <FontIcon FontSize="16" Glyph="&#xE7A8;" />
                </ToggleButton>
                <Button x:Name="ApplyCropButton" x:Uid="ApplyCropButton" Click="OnApplyCrop" Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE8FB;" />
                </Button>
                <Button x:Name="CancelCropButton" x:Uid="CancelCropButton" Click="OnCancelCrop" Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>
                <StackPanel x:Name="CropFields" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Uid="CropXLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropX" x:Uid="CropX" Tag="X" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                    <TextBlock x:Uid="CropYLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropY" x:Uid="CropY" Tag="Y" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                    <TextBlock x:Uid="CropWLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropW" x:Uid="CropW" Tag="W" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                    <TextBlock x:Uid="CropHLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox x:Name="CropH" x:Uid="CropH" Tag="H" Width="76" AcceptsExpression="True" ValueChanged="OnCropField" />
                </StackPanel>
                <ToggleButton x:Name="TextActionsButton" x:Uid="TextActionsButton" Click="OnTextActions">
                    <FontIcon FontSize="16" Glyph="&#xE8C1;" />
                </ToggleButton>
                <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="UndoButton" x:Uid="UndoButton" Click="OnUndo" IsEnabled="False">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button x:Name="RedoButton" x:Uid="RedoButton" Click="OnRedo" IsEnabled="False">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>
            </local:WrapPanel>
            <StackPanel x:Name="RightTools" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                <StackPanel x:Name="OutputTools" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <Button x:Uid="CopyButton" Click="OnCopy">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                    <SplitButton x:Name="SaveSplitButton" x:Uid="SaveButton" Click="OnSave" Padding="11,6.5,11,6.5">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="SaveMenu" Placement="Bottom">
                                <MenuFlyoutItem x:Name="SaveEditableItem" x:Uid="SaveEditableItem" Click="OnSaveEditable">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <!-- A recording has no Save menu (as in Snipping Tool): plain Save as instead of the split button. -->
                    <Button x:Name="SaveVideoButton" x:Uid="SaveButton" Click="OnSaveVideo" Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    </Button>
                    <Button x:Uid="ShareButton" Click="OnShare">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                    </Button>
                    <Button x:Name="GifButton" x:Uid="GifButton" Click="OnGif" Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xF4A9;" />
                    </Button>
                    <Border x:Name="AiSeparator" Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <SplitButton x:Name="AgentButton" x:Uid="AgentButton" Padding="11,6.5,11,6.5" Click="OnSendToAgent">
                        <FontIcon FontSize="16" Glyph="&#xE724;" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="AgentMenu" Placement="Bottom" Opening="OnAgentMenuOpening" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Name="AskAiButton" x:Uid="AskAiButton" Click="OnAskAi">
                        <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                    </Button>
                </StackPanel>
                <DropDownButton x:Name="MoreButton" x:Uid="MoreButton" Padding="11,5.5,11,5.5">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MoreMenu" Placement="Bottom" Opening="OnMoreMenuOpening">
                            <!-- Toolbar buttons a narrow window moves here; texts are the buttons' names. -->
                            <MenuFlyoutItem x:Name="OpenItem" Click="OnOpen" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="HistoryItem" Click="OnHistoryClick" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="AgentItem" Visibility="Collapsed">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE724;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="AskAiItem" Click="OnAskAi" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8BD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator x:Name="CompactSeparator" Visibility="Collapsed" />
                            <MenuFlyoutSubItem x:Name="ZoomItem" x:Uid="ZoomItem">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE71E;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem x:Uid="ZoomResetItem" Click="OnZoomReset" />
                                <MenuFlyoutItem x:Uid="ZoomInItem" Click="OnZoomIn" />
                                <MenuFlyoutItem x:Uid="ZoomOutItem" Click="OnZoomOut" />
                                <MenuFlyoutItem x:Uid="ZoomFitItem" Click="OnZoomFit" />
                            </MenuFlyoutSubItem>
                            <ToggleMenuFlyoutItem x:Name="RulerItem" x:Uid="RulerItem" Click="OnRulerToggled">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECC6;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="PrintItem" x:Uid="PrintItem" Click="OnPrint">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="PaintItem" x:Uid="PaintItem" Click="OnEditInPaint">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="OpenFolderItem" Click="OnOpenScreenshotsFolder">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE838;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Uid="SettingsButton" Click="OnSettings" Background="Transparent" BorderThickness="0">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <local:WrapPanel x:Name="TextActionsBar" Spacing="8" LineSpacing="8" Margin="8,0,8,8"
                             HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TextActionsStatus" x:Uid="TextActionsStatus" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="CopySelectedTextButton" x:Uid="CopySelectedTextButton" Click="OnCopySelectedText" IsEnabled="False" />
                <Button x:Name="RedactSelectedTextButton" x:Uid="RedactSelectedTextButton" Click="OnRedactSelectedText" IsEnabled="False" />
                <Button x:Name="CopyAllTextButton" x:Uid="CopyAllTextButton" Click="OnCopyAllText" IsEnabled="False" />
                <Button x:Name="CopyTableButton" x:Uid="CopyTableButton" Click="OnCopyTable" IsEnabled="False" />
                <SplitButton x:Name="QuickRedactButton" x:Uid="QuickRedactButton" Click="OnQuickRedact" IsEnabled="False">
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="QuickRedactMenu" Placement="Bottom" Opening="OnQuickRedactMenuOpening">
                            <ToggleMenuFlyoutItem x:Name="RedactEmailItem" x:Uid="RedactEmailItem" Click="OnRedactKindToggled" />
                            <ToggleMenuFlyoutItem x:Name="RedactPhoneItem" x:Uid="RedactPhoneItem" Click="OnRedactKindToggled" />
                            <ToggleMenuFlyoutItem x:Name="RedactIpItem" x:Uid="RedactIpItem" Click="OnRedactKindToggled" />
                            <ToggleMenuFlyoutItem x:Name="RedactBankItem" x:Uid="RedactBankItem" Click="OnRedactKindToggled" />
                            <ToggleMenuFlyoutItem x:Name="RedactSecretsItem" x:Uid="RedactSecretsItem" Click="OnRedactKindToggled" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="RedactClearItem" x:Uid="RedactClearItem" Click="OnRedactClear" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <local:WrapPanel x:Name="QrResults" Spacing="8" LineSpacing="8" />
            </local:WrapPanel>
            <InfoBar x:Name="Message" Margin="8,0,8,8" IsOpen="False" Severity="Error" />
        </StackPanel>

        <TextBlock x:Name="Hint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer x:Name="ImageScroller" Grid.Row="2" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8" />

        <MediaPlayerElement x:Name="VideoPlayer" x:Uid="VideoPlayer" Grid.Row="2" Visibility="Collapsed" Margin="8,0,8,8"
                            AreTransportControlsEnabled="True" />
    </Grid>
</Page>
