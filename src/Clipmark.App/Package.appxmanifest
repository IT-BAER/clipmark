<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap11="http://schemas.microsoft.com/appx/manifest/uap/windows10/11"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap uap5 uap11 com desktop">

  <Identity
    Name="IT-BAER.Clipmark-ScreenshotRecorder"
    Publisher="CN=EA9F6DA0-A9BD-42B5-97C5-9D09DEB1535F"
    Version="1.1.1.0" />

  <mp:PhoneIdentity PhoneProductId="B1A4BD56-7F62-4DFB-B1B7-558FD8903F06" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Clipmark - Screenshot &amp; Recorder</DisplayName>
    <PublisherDisplayName>IT-BAER</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Clipmark"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- TaskId is used by Shell\SystemIntegration. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="ClipmarkStartup" Enabled="false" DisplayName="Clipmark" />
        </uap5:Extension>
        <!-- Toast clicks: Windows App SDK app notifications activate this COM class. The build does not expand
             $targetnametoken$ in ExeServer, so the exe name is literal. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="58EF67BC-3689-4348-AD84-9996BF81ACFA" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Clipmark.App.exe" DisplayName="Clipmark" Arguments="----AppNotificationActivated:">
              <com:Class Id="58EF67BC-3689-4348-AD84-9996BF81ACFA" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Ask AI: api.anthropic.com. Full trust is not network-isolated; declared so the Store listing shows it. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Monitor capture without the picker (CaptureItems.ForMonitor) and without the yellow border (ScreenRecorder). -->
    <uap11:Capability Name="graphicsCaptureProgrammatic" />
    <uap11:Capability Name="graphicsCaptureWithoutBorder" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
