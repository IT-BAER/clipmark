<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipmark.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4,8,8">
            <Button Click="OnBack" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Padding="24,8,24,24" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                    <TextBlock Text="Capture hotkey" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="CtrlBox" Content="Ctrl" MinWidth="0" Click="OnHotkeyChanged" />
                        <CheckBox x:Name="AltBox" Content="Alt" MinWidth="0" Click="OnHotkeyChanged" />
                        <CheckBox x:Name="ShiftBox" Content="Shift" MinWidth="0" Click="OnHotkeyChanged" />
                        <CheckBox x:Name="WinBox" Content="Win" MinWidth="0" Click="OnHotkeyChanged" />
                        <ComboBox x:Name="KeyBox" MinWidth="140" SelectionChanged="OnHotkeyChanged"
                                  AutomationProperties.Name="Hotkey key" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="PrintScreenSwitch" Header="Use the Print Screen key to open Clipmark" Toggled="OnPrintScreenToggled"
                                  AutomationProperties.Name="Use the Print Screen key to open Clipmark" />
                    <TextBlock Text="Turns off the Windows option that opens Snipping Tool with Print Screen. Turning this off puts it back."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Startup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="StartupSwitch" Header="Start Clipmark when Windows starts" Toggled="OnStartupToggled"
                                  AutomationProperties.Name="Start Clipmark when Windows starts" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Default capture" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ModeBox" Header="Mode" MinWidth="180" SelectionChanged="OnModeChanged" />
                        <ComboBox x:Name="DelayBox" Header="Delay" MinWidth="140" SelectionChanged="OnDelayChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="After a capture" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="ClipboardSwitch" Header="Copy to clipboard" Toggled="OnTogglesChanged" />
                    <ToggleSwitch x:Name="ToastSwitch" Header="Show a notification" Toggled="OnTogglesChanged" />
                    <ToggleSwitch x:Name="AutoSaveSwitch" Header="Save automatically" Toggled="OnTogglesChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                        <Button Content="Change folder" Click="OnBrowse" />
                        <Button x:Name="ResetFolderButton" Content="Use default" Click="OnResetFolder" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Screen recording" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="RecCtrlBox" Content="Ctrl" MinWidth="0" Click="OnRecordHotkeyChanged" />
                        <CheckBox x:Name="RecAltBox" Content="Alt" MinWidth="0" Click="OnRecordHotkeyChanged" />
                        <CheckBox x:Name="RecShiftBox" Content="Shift" MinWidth="0" Click="OnRecordHotkeyChanged" />
                        <CheckBox x:Name="RecWinBox" Content="Win" MinWidth="0" Click="OnRecordHotkeyChanged" />
                        <ComboBox x:Name="RecKeyBox" MinWidth="140" SelectionChanged="OnRecordHotkeyChanged"
                                  AutomationProperties.Name="Recording hotkey key" />
                    </StackPanel>
                    <TextBlock x:Name="RecordHotkeyStatus" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="SystemAudioSwitch" Header="Record system audio" Toggled="OnRecordTogglesChanged" />
                    <ToggleSwitch x:Name="MicrophoneSwitch" Header="Record the microphone" Toggled="OnRecordTogglesChanged" />
                    <TextBlock x:Name="RecordingsFolderText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" AutomationProperties.Name="Version" />
                    <HyperlinkButton Content="Source code and releases" NavigateUri="https://github.com/IT-BAER/clipmark" Padding="0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
